# Python environments and generated bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Test, notebook, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local editor and operating system files
.vscode/
.DS_Store
Thumbs.db

# Secrets and local configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Source and derived data stay local
data/raw/*
!data/raw/README.md
data/processed/*

# Fitted estimators and generated reports/exports stay local
models/*
outputs/*
*.joblib
*.pkl

# Historical UI backups are retained locally but not published
.design-backup-*
MicroSegment/
